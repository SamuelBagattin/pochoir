---
import Base from '../layouts/Base.astro';
import { frPrivacy } from '../i18n/fr-privacy';
---

<Base title={`${frPrivacy.title} — Pochoir`} description={frPrivacy.lede} current="privacy">
  <article class="prose wrap wrap--prose">
    <h1>{frPrivacy.title}</h1>
    <p class="prose__lede">{frPrivacy.lede}</p>

    {
      frPrivacy.sections.map((section) => (
        <section aria-labelledby={section.id}>
          <h2 id={section.id}>{section.heading}</h2>
          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {section.facts && (
            <dl class="fact-list">
              {section.facts.map((fact) => (
                <div>
                  <dt>{fact.term}</dt>
                  <dd>{fact.detail}</dd>
                </div>
              ))}
            </dl>
          )}
          {section.list && (
            <ul>
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </article>
</Base>
