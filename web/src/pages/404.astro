---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';

/**
 * The not-found page, and it is a real static asset on purpose.
 *
 * Without it, `wrangler deploy` uploads a no-op Worker whose `fetch()` answers
 * any unmatched path with the string `Not found`. Cloudflare does not apply
 * `_headers` to a response generated by Worker code, so that reply carries no
 * Content-Security-Policy, no `nosniff` and no `Referrer-Policy` — and it is
 * in English, on a French-first product, with no way back to the tool.
 *
 * Pairing this page with `"not_found_handling": "404-page"` in
 * `web/wrangler.jsonc` keeps the response inside the asset router, where the
 * headers apply. One page closes a header gap and a language gap at once.
 *
 * Whoever edits this: no inline `<style>` and no `style=` attribute. The CSP
 * has no `'unsafe-inline'`, `make check` asserts it, and a 404 page is exactly
 * where somebody would reflexively inline one rule.
 */
---

<Base title={`${t.notFound.title} — ${t.site.name}`} description={t.notFound.description} current="none">
  <article class="prose wrap wrap--prose">
    <h1>{t.notFound.title}</h1>
    <p class="prose__lede">{t.notFound.lede}</p>
    <div class="actions">
      <a class="btn btn--primary" href="/">{t.notFound.backToTool}</a>
      <a class="btn" href="/confidentialite/">{t.nav.privacy}</a>
    </div>
  </article>
</Base>
