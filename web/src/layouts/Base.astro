---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/app.css';
import { t } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Which nav item is the current page, or 'none' for a page not in the nav. */
  current: 'tool' | 'privacy' | 'none';
}

const { title, description, current } = Astro.props;
const SOURCE_URL = 'https://github.com/SamuelBagattin/pochoir';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!--
      No font CDN, no analytics, no tag manager, no error reporter, and no
      preconnect to anybody. If an element in this head ever points at another
      origin, the product claim is false — and the CSP in web/README.md will
      refuse it anyway. That is the intended order of defence: the claim first,
      the header as the evidence a reviewer can read.
    -->
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skipToContent}</a>

    <div class="shell">
      <header class="masthead">
        <div class="wrap masthead__inner">
          <a class="wordmark" href="/">
            <svg
              class="wordmark__glyph"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <rect
                x="4"
                y="2.5"
                width="16"
                height="19"
                rx="1.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-opacity="0.45"></rect>
              <path
                d="M6.5 17.5 17.5 6.5"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"></path>
            </svg>
            {t.site.name}
          </a>
          <nav class="masthead__nav" aria-label="Principal">
            <a href="/" aria-current={current === 'tool' ? 'page' : undefined}>
              {t.nav.tool}
            </a>
            <a
              href="/confidentialite/"
              aria-current={current === 'privacy' ? 'page' : undefined}
            >
              {t.nav.privacy}
            </a>
            <a href={SOURCE_URL} rel="noreferrer">{t.nav.source}</a>
          </nav>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="colophon">
        <div class="wrap colophon__row">
          <p>{t.footer.noTracking}</p>
          <p>{t.footer.builtBy} {t.footer.licence}</p>
        </div>
      </footer>
    </div>
  </body>
</html>
