// Cloudflare Workers static assets, with no Worker code at all.
//
// `assets.directory` and no `main` is what makes this an assets-only Worker:
// every request is answered from ./dist by the platform, nothing we wrote runs
// on the edge, and therefore nothing we wrote can see a document. ADR-0001
// chose this shape; ADR-0004 Decision 5 explains why a Worker would break the
// `_headers` file that carries the Content-Security-Policy.
//
// `account_id` is deliberately absent. A deploy takes it from the environment
// (`CLOUDFLARE_ACCOUNT_ID`) together with `CLOUDFLARE_API_TOKEN`; neither
// belongs in a public repository, and there is no account yet. See
// docs/DEPLOY.md for what a deploy would do and what is still missing.
{
  "name": "pochoir",

  // The date whose platform behaviour this configuration was written against.
  // It pins runtime semantics the way rust-toolchain.toml pins the compiler.
  "compatibility_date": "2026-11-26",

  "assets": {
    "directory": "./dist",

    // Astro writes /confidentialite/index.html, so a request for
    // /confidentialite is served by adding the trailing slash. This is the
    // platform default, stated because the site's URLs depend on it.
    "html_handling": "auto-trailing-slash",

    // There is no 404.html in the build. `none` returns a 404 rather than
    // silently serving index.html for every unknown path, which would make a
    // typo look like the application.
    //
    // KNOWN GAP, found by reading `make web-deploy-check`'s output rather than
    // the documentation: an assets-only deployment is not literally Worker-
    // free. wrangler generates and uploads `no-op-worker.js`, whose `fetch()`
    // returns `new Response("Not found", { status: 404, headers: {
    // "Content-Type": "text/html" }})`. Cloudflare documents that `_headers`
    // is not applied to responses generated by Worker code, so THE 404
    // RESPONSE ON THIS SITE CARRIES NONE OF THE HEADERS ABOVE — no CSP, no
    // nosniff — and is labelled text/html. That is a header gap on a path that
    // serves a fixed 11-byte string, not an exfiltration risk, but ADR-0001's
    // "no Worker code" premise is narrower than it reads.
    //
    // The fix is a `404.astro` in the build plus `"not_found_handling":
    // "404-page"`, which keeps the response inside the asset router where
    // `_headers` applies. That needs a page written in French and is left to
    // whoever owns web/src. Not verified against a live deployment: it follows
    // from Cloudflare's documented rule and from the artefact wrangler emits.
    "not_found_handling": "none"
  },

  // Off, explicitly. Workers observability samples request metadata into
  // Cloudflare's logs; for a tool whose claim is that nothing about a document
  // leaves the device, the request log is the nearest thing to a telemetry
  // channel and we do not want one.
  "observability": {
    "enabled": false
  }
}
